ANTHROPIC_API_KEY=sk-ant-...
GITHUB_TOKEN=github_pat_...
GITHUB_REPO=kadishay/vikunja
GITHUB_WEBHOOK_SECRET=your-secret-here
VIKUNJA_REPO_PATH=/Users/kadishay/Code/vikunja
VIKUNJA_API_BASE=http://localhost:3456
VIKUNJA_API_TOKEN=
# Username + password used by Playwright to log into the Vikunja frontend before reproducing UI bugs
VIKUNJA_USERNAME=
VIKUNJA_PASSWORD=
NOTIFY_USER=

# Phase 2 — Slack (leave blank to disable; agent falls back to stdout + GitHub comments)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_CHANNEL=#bug-triage

# Phase 2 — Playwright (set to true to enable browser-based UI reproduction + verification)
# Requires: pip install playwright && playwright install chromium
# Requires: Vikunja frontend running on port 4173 (pnpm dev)
PLAYWRIGHT_ENABLED=false
