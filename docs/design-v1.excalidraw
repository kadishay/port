    {
      "id": "MfNHVlNQvhf86-h5O-8nG",
      "type": "text",
      "x": 1246.153950405189,
      "y": -7874.356892435109,
      "width": 766.0794677734375,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bZ6",
      "roundness": null,
      "seed": 1087378219,
      "version": 1137,
      "versionNonce": 907346443,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786981812449,
      "link": null,
      "locked": false,
      "text": "Drop Off process:\n1. Car dropped of and images taken\n2. AI Pipeline finds defects\n3. Data is passed to finalization - invoice generate, charged, and sent to user\n4. User gets invoice and starts a dipute\n5. ML decides to auto accept and adds data, else an ops manager reviews\n6. If dispute is accepted a re-finalization and refund is made, else notify user",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Drop Off process:\n1. Car dropped of and images taken\n2. AI Pipeline finds defects\n3. Data is passed to finalization - invoice generate, charged, and sent to user\n4. User gets invoice and starts a dipute\n5. ML decides to auto accept and adds data, else an ops manager reviews\n6. If dispute is accepted a re-finalization and refund is made, else notify user",
      "autoResize": true,
      "lineHeight": 1.25
    },
